<?xml version="1.0" encoding="utf-8"?>
<!-- OSMP is a self-hosted LAN tool: the server usually runs plain HTTP on a
     private address. Cleartext is therefore permitted; HTTPS works too. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
